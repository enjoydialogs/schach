root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{cs,csx}]
indent_size = 4

[*.{js,jsx,ts,tsx,json,jsonc,css,scss,html,yml,yaml}]
indent_size = 2

[*.{csproj,props,targets,slnx}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# ---------------------------------------------------------------------------
# C# code style (subset; enforced in build via EnforceCodeStyleInBuild).
# ---------------------------------------------------------------------------
[*.cs]

# Prefer pattern matching null checks: `is null` / `is not null`  (project rule)
csharp_style_prefer_pattern_matching = true:suggestion
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:warning

# Namespaces & usings
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:suggestion

# `var` usage
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_for_built_in_types = false:suggestion

# Expression-level preferences
dotnet_style_prefer_conditional_expression_over_assignment = true:suggestion
csharp_prefer_braces = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion

# Naming: private fields => _camelCase
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_prefix
dotnet_naming_rule.private_fields_underscore.severity = suggestion
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_prefix.capitalization = camel_case
dotnet_naming_style.underscore_prefix.required_prefix = _

# ---------------------------------------------------------------------------
# Analyzer-Ausnahmen (AnalysisLevel latest-recommended, Warnungen sind Fehler).
# ---------------------------------------------------------------------------
# CA1716: VB-Schluesselwoerter wie `Set` sind fuer ein reines C#-Projekt bedeutungslos;
# IAppDbContext.Set<T>() spiegelt bewusst DbContext.Set<T>().
dotnet_diagnostic.CA1716.severity = none

[tests/**.cs]
# Testnamen lesen sich mit Unterstrichen (Methode_Situation_Erwartung).
dotnet_diagnostic.CA1707.severity = none
