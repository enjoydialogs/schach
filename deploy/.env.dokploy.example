# Schluessel fuer den Environment-Tab des Dokploy-Compose-Dienstes von Schach (SCHACH-SPEC 13.5).
# KEY=value-Zeilen dort einfuegen; Dokploy schreibt sie in die .env, die docker-compose.dokploy.yml
# liest. Diese Datei nennt NUR die Schluessel. Werte, Subnetze, IPs und Panel-Adressen gehoeren nie
# ins Repository.

# ---------------------------------------------------------------- Images
# GHCR-Namensraum, klein geschrieben: ghcr.io/<owner> (release.yml pusht dorthin).
REGISTRY=
# Das bewegte Tag, das release.yml auf einen gebauten SHA zeigt: `prod`. Kein SHA.
IMAGE_TAG=

# ---------------------------------------------------------------- Netz (Pflicht)
# Subnetz von dokploy-network in CIDR-Schreibweise. Einmal auf der Box lesen:
#   docker network inspect dokploy-network --format '{{(index .IPAM.Config 0).Subnet}}'
# ASP.NET nimmt X-Forwarded-* genau aus diesem Bereich an (SCHACH-SPEC 11.4).
TRAEFIK_NETWORK=

# ---------------------------------------------------------------- Datenbank (Pflicht)
# Nur Buchstaben und Ziffern (steht in einer Npgsql-Verbindungszeichenfolge), z. B.
#   openssl rand -hex 32
# Gilt nur bei der ersten Initialisierung des Volumes pgdata (siehe deploy/README.md).
POSTGRES_PASSWORD=

# ---------------------------------------------------------------- Mail (ab S2a, optional bis dahin)
LETTERMINT_API_TOKEN=
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO_ADDRESS=
# Empfaenger der Budget- und Warnmails (SCHACH-SPEC 14.2).
OPERATOR_EMAIL=

# ---------------------------------------------------------------- Sprueche (ab S2c, optional)
# Mistral-Schluessel, EU-Endpunkt. Leer: Ersatzsprueche.
MISTRAL_API_KEY=

# ---------------------------------------------------------------- Tracing (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---------------------------------------------------------------- Engine (optional)
# Leer = Vorgaben aus SCHACH-SPEC 5.2. Nach der VPS-Messung Teil 2 hier nachziehen.
MAIA_TORCH_THREADS=
MAIA_QUEUE_MAX=
SF_POOL_SIZE=
SF_MAX_MOVETIME_MS=
FAIRY_POOL_SIZE=
ENGINE_ROLES=
