# Schluessel fuer den Environment-Tab des Dokploy-Compose-Dienstes von Schach (SCHACH-SPEC 13.5).
# KEY=value-Zeilen dort einfuegen; Dokploy schreibt sie in die .env, die docker-compose.dokploy.yml
# liest. Diese Datei nennt NUR die Schluessel. Werte, Subnetze, IPs und Panel-Adressen gehoeren nie
# ins Repository.

# ---------------------------------------------------------------- Images
# GHCR-Namensraum, klein geschrieben: ghcr.io/<owner> (release.yml pusht dorthin).
REGISTRY=
# Das bewegte Tag, das release.yml auf einen gebauten SHA zeigt: `prod`. Kein SHA.
IMAGE_TAG=

# ---------------------------------------------------------------- Netz (Pflicht)
# Subnetz von dokploy-network in CIDR-Schreibweise. Einmal auf der Box lesen:
#   docker network inspect dokploy-network --format '{{(index .IPAM.Config 0).Subnet}}'
# ASP.NET nimmt X-Forwarded-* genau aus diesem Bereich an (SCHACH-SPEC 11.4).
TRAEFIK_NETWORK=

# ---------------------------------------------------------------- Datenbank (Pflicht)
# Nur Buchstaben und Ziffern (steht in einer Npgsql-Verbindungszeichenfolge), z. B.
#   openssl rand -hex 32
# Gilt nur bei der ersten Initialisierung des Volumes pgdata (siehe deploy/README.md).
POSTGRES_PASSWORD=

# ---------------------------------------------------------------- Mail (ab S2a, optional bis dahin)
LETTERMINT_API_TOKEN=
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO_ADDRESS=
# Empfaenger der Budget- und Warnmails (SCHACH-SPEC 14.2).
OPERATOR_EMAIL=
# Mail:MaxJeTag. An den gebuchten Lettermint-Tarif anpassen (SCHACH-SPEC 11.3, 16 Punkt 4).
MAIL_MAX_JE_TAG=

# ---------------------------------------------------------------- Limits (optional)
# Leer = Vorgaben aus SCHACH-SPEC 11.2. Nach der VPS-Messung Teil 2 nachziehen (16 Punkt 1);
# IP-Limits bei Mobilfunk-CGNAT im Zweifel nach oben.
# Limits:PartienJeSpielerUndTag, rollierend 24 h.
LIMITS_PARTIEN_JE_SPIELER_UND_TAG=
# Limits:GastPartienJeIpUndStunde, Limiter gast-partie-je-ip.
LIMITS_GAST_PARTIEN_JE_IP_UND_STUNDE=
# Limits:OffeneGastPartienGesamt, darueber keine neuen Gast-Partien.
LIMITS_OFFENE_GAST_PARTIEN_GESAMT=
# Limits:ZuegeJePartieUndMinute, Limiter zuege-je-partie.
LIMITS_ZUEGE_JE_PARTIE_UND_MINUTE=
# Limits:TippsJePartieUndMinute, Limiter tipp-je-partie.
LIMITS_TIPPS_JE_PARTIE_UND_MINUTE=
# Limits:AktionenJePartieUndMinute, Limiter aktion-je-partie.
LIMITS_AKTIONEN_JE_PARTIE_UND_MINUTE=
# Limits:EngineZuegeGleichzeitig, gleichzeitige POST .../zuege.
LIMITS_ENGINE_ZUEGE_GLEICHZEITIG=
# Limits:EngineZuegeWarteschlange, Warteschlange dazu.
LIMITS_ENGINE_ZUEGE_WARTESCHLANGE=
# Limits:StockfishTippsGleichzeitig, gleichzeitige POST .../tipp.
LIMITS_STOCKFISH_TIPPS_GLEICHZEITIG=
# Limits:StockfishTippsWarteschlange, Warteschlange dazu.
LIMITS_STOCKFISH_TIPPS_WARTESCHLANGE=

# ---------------------------------------------------------------- Sprueche (ab S2c, optional)
# Mistral-Schluessel, EU-Endpunkt. Leer: Ersatzsprueche.
MISTRAL_API_KEY=

# ---------------------------------------------------------------- Tracing (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---------------------------------------------------------------- Engine (optional)
# Leer = Vorgaben aus SCHACH-SPEC 5.2. Nach der VPS-Messung Teil 2 hier nachziehen.
MAIA_TORCH_THREADS=
MAIA_QUEUE_MAX=
SF_POOL_SIZE=
SF_MAX_MOVETIME_MS=
FAIRY_POOL_SIZE=
ENGINE_ROLES=
