<Project>
  <!--
    Zentrale Paketversionen (CPM). Eingefroren ab Phase 0 und zugleich Append-Register
    (SCHACH-SPEC 15.1 Regel 4 und 5): neue Pakete nur anhaengen, Versionen nur per Geruest-PR.

    Versionsregel des Betreibers (SCHACH-SPEC 13.1): .NET 10, jeweils neueste stabile Version
    mit net10.0-Unterstuetzung, Microsoft.*, EF Core und Npgsql auf der 10.0.x-Linie.
    Stand der Versionen: 2026-11-07, geprueft gegen nuget.org.
  -->
  <ItemGroup Label="Regeln">
    <!-- Schach-Regeln auf dem Server (SCHACH-SPEC 3.4, 13.1). NuGet 1.2.0 liegt hinter Repo 1.3.x. -->
    <PackageVersion Include="Gera.Chess" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup Label="Persistenz">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup Label="Http und Zeit">
    <!-- Engine-Client und Mistral-Client (SCHACH-SPEC 5.2, 6.3). -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <!-- FakeTimeProvider fuer Uhr- und Sweep-Tests (SCHACH-SPEC 8.6). -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
  </ItemGroup>

  <ItemGroup Label="Telemetrie">
    <!-- OTLP-Tracing, nur aktiv mit OTEL_EXPORTER_OTLP_ENDPOINT. Die Pakete bewegen sich gemeinsam. -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.2" />
    <PackageVersion Include="Npgsql.OpenTelemetry" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <!-- xUnit v3 auf Microsoft.Testing.Platform: Testprojekte sind eigene Programme
         (OutputType=Exe, UseMicrosoftTestingPlatformRunner=true), `dotnet test` findet sie ueber
         global.json. Microsoft.NET.Test.Sdk und xunit.runner.visualstudio entfallen. -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.2" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup Label="Transitive Pins">
    <!-- Microsoft.EntityFrameworkCore.Design zieht ueber Microsoft.Build.Tasks.Core aeltere
         Kryptografie-Pakete mit bekannten Advisories. Auf die aktuelle 10.0.x-Linie gezogen. -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.14" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>
</Project>
